            <column name="create_time" type="datetime(6)"><constraints nullable="false"/></column>
            <column name="update_time" type="datetime(6)"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="job_application" columnNames="user_id,job_id" constraintName="uk_job_application_user_job"/>
        <createIndex tableName="job_application" indexName="idx_job_application_user_status">
